{
  "name": "monee",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src server --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:mascots": "node tests/test_all_mascots.js",
    "test:e2e": "node tools/verify-app.mjs",
    "test:auth:e2e": "node tools/verify-auth.mjs",
    "test:pwa": "node tools/verify-pwa.mjs",
    "benchmark": "node tools/benchmark.mjs",
    "test:voice:e2e": "node tools/verify-voice.mjs",
    "dev:worker": "npm run build && wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "idb": "^8.0.0",
    "jose": "^6.2.13",
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "4.1.12",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "miniflare": "5.20261023.2-beta",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "4.1.12",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": "^22.23.4"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
